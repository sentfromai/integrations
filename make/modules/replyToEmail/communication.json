{
  "url": "/messages/{{encodeURL(parameters.message_id)}}/reply",
  "method": "POST",
  "type": "json",
  "body": {
    "text": "{{parameters.text}}",
    "html": "{{parameters.html}}",
    "reply_all": "{{parameters.reply_all}}",
    "client_id": "{{parameters.client_id}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
